{
  "meta": {
    "project": "Avito ПоДелу",
    "version": "1.1",
    "source": "20 production references + 12 graphic-library guides received 2026-09-11",
    "note": "Reference PNGs are 1920x1081; production canvas is 1920x1080"
  },
  "canvas": {
    "width": 1920,
    "height": 1080,
    "aspectRatio": "16:9",
    "safeAreaPx": {
      "left": 90,
      "right": 90,
      "top": 56,
      "bottom": 72
    }
  },
  "grid": {
    "columns": 12,
    "gutterPx": 20,
    "baseUnitPx": 8,
    "commonSpacingPx": [16, 20, 24, 32, 40, 48, 64, 80],
    "commonSplits": ["4/8", "5/7", "6/6", "3/3/3/3"],
    "threeColumnReferencePx": {
      "x": [90, 678, 1265],
      "widthApprox": 568
    }
  },
  "colors": {
    "white": "#FFFFFF",
    "black": "#000000",
    "lightCanvas": "#EEEEEE",
    "deepGreen": "#003914",
    "brightGreen": "#04E061",
    "cyan": "#00AAFF",
    "mutedGray": "#858585",
    "mutedGrayLight": "#9D9D9D",
    "violet": "#9659EA",
    "coral": "#FB696C",
    "aqua": "#5FD8C4",
    "nearBlack3dPreview": "#1D1F1E",
    "forestTile": "#1E532E",
    "paleMintTile": "#F7FDF8",
    "paleMintAccent": "#B4F4CA",
    "greenGradient": {
      "from": "#01461D",
      "to": "#017A33",
      "direction": "left-to-right"
    },
    "greenPanelGradient": {
      "from": "#003914",
      "to": "#01843A"
    },
    "areaChart": {
      "cyan": {
        "line": "#00AAFF",
        "fillTop": "#41BFFF",
        "fillBottom": "#B2E5FF"
      },
      "green": {
        "line": "#04E061",
        "fillTop": "#06DF62",
        "fillBottom": "#055B26"
      },
      "maxAccentModesPerChart": 1
    }
  },
  "typography": {
    "primary": "Avito Sans",
    "fallbacks": ["Arial", "Helvetica Neue", "Inter", "sans-serif"],
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "sizesPx": {
      "service": [18, 22],
      "source": [14, 18],
      "cardBody": [22, 28],
      "body": [30, 38],
      "metricLabel": [26, 34],
      "cardTitle": [36, 48],
      "caseSubtitle": [42, 52],
      "titleCompact": [48, 60],
      "title": [60, 76],
      "titleHero": [72, 88],
      "metric": [80, 132]
    },
    "lineHeight": {
      "title": [0.96, 1.06],
      "body": [1.08, 1.2],
      "cardBody": [1.08, 1.18]
    }
  },
  "cards": {
    "radiusPx": [28, 36],
    "nestedRadiusPx": [24, 32],
    "paddingPx": [28, 40],
    "largePaddingPx": 48,
    "border": "none",
    "shadow": "none or imperceptible"
  },
  "chips": {
    "heightPx": [38, 48],
    "paddingHorizontalPx": [14, 24],
    "strokePx": [2, 3],
    "maxLines": 2,
    "outline": {
      "fill": "transparent",
      "stroke": "#04E061",
      "text": "#04E061",
      "radiusPx": [10, 16]
    },
    "filled": {
      "fill": "#04E061",
      "text": "#003914",
      "radiusPx": [18, 28]
    },
    "mutedState": "reduce opacity; do not invent another green"
  },
  "underline": {
    "color": "#04E061",
    "thicknessPx": [8, 12],
    "style": "one irregular gesture; wave, kink, short gap or linked second segment allowed",
    "maxPerSlide": 1
  },
  "graphics": {
    "gestureBudgetPerSlide": 1,
    "twoDIcons": {
      "container": "rounded-square tile",
      "radiusRatio": [0.2, 0.25],
      "pictogramScaleRatio": [0.65, 0.78],
      "dark": {
        "canvas": "#003914",
        "tile": "#1E532E",
        "foreground": "green gradient"
      },
      "light": {
        "canvas": "#FFFFFF",
        "tileRange": ["#F7FDF8", "#B4F4CA"],
        "foreground": "saturated green gradient"
      },
      "semanticFamilies": ["green", "cyan/aqua", "violet", "coral/red"],
      "maxFamiliesPerSemanticGroup": 1
    },
    "threeDIcons": {
      "darkBody": "smoky dark or translucent",
      "lightBody": "milky white or pale mint glass",
      "rim": "luminous green",
      "allowedRimMaterials": ["metallic", "ribbed fabric", "perforated fabric"],
      "allowedInteriors": ["matte glass", "faceted/textured glass", "empty rim"],
      "maxMaterialSystemsPerGroup": 1,
      "maxHeroObjectsPerSlide": 3
    },
    "macroStroke": {
      "color": "#04E061",
      "position": "behind cutout, may re-emerge around edges",
      "avoid": ["face", "hands", "critical product details", "readable UI"],
      "combineWithUnderline": false
    },
    "dataViz": {
      "modes": ["cyan", "green"],
      "preferredComponents": ["metric card", "rounded progress track", "minimal area chart", "numbered tile"],
      "avoid": ["dashboard chrome", "dense axes", "marker noise", "multiple accent modes"]
    }
  },
  "imageRules": {
    "mainVisualPerSlide": 1,
    "preferredTypes": ["2D tile-icon group", "3D cutout", "smartphone UI mockup", "rounded portrait", "cutout + macro stroke", "single chart"],
    "allowCropAtCardEdge": true,
    "allowCropAtCanvasEdge": true,
    "allowTextOverlap": false
  }
}
